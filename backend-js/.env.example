# Porta do servidor
PORT=3000

# ─── Banco de dados ────────────────────────────────────────────────────────────
# Se não definir STANDALONE_DB_URL, o SQLite local é usado automaticamente.
# Copie este arquivo para .env e descomente a opção desejada:

# SQLite (padrão — sem instalação)
# STANDALONE_DB_URL=sqlite:./data/sos.db

# PostgreSQL
# STANDALONE_DB_URL=postgres://usuario:senha@localhost:5432/sosmulher

# MySQL / MariaDB
# STANDALONE_DB_URL=mysql://usuario:senha@localhost:3306/sosmulher

# Microsoft SQL Server
# STANDALONE_DB_URL=mssql://usuario:senha@localhost:1433/sosmulher
