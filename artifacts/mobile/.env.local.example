# SOS Mulher — Variáveis de ambiente do app mobile (dev local)
# Copie este arquivo para .env.local e ajuste conforme seu setup.

# ─── URL da API ──────────────────────────────────────────────────────────────
# Aponta o app para o servidor API rodando na sua máquina.

# Opção 1: Rodar no NAVEGADOR (expo start --web)
EXPO_PUBLIC_API_URL=http://localhost:8080

# Opção 2: Rodar no CELULAR com Expo Go
# Substitua pelo IP da sua máquina na rede Wi-Fi local.
# Windows: rode "ipconfig" e procure "Endereço IPv4"
# Mac/Linux: rode "ifconfig" e procure inet na interface Wi-Fi
# EXPO_PUBLIC_API_URL=http://192.168.1.100:8080

# Opção 3: Usando ngrok (para testar Twilio localmente)
# EXPO_PUBLIC_API_URL=https://abc123.ngrok.io
